# =====================================================================
# GHTSP Database & Pipeline Configuration (Template)
# Copy this file to .env and fill in your database credentials.
# =====================================================================

DB_TYPE=sqlite
SQLITE_DB_PATH=data/ghtsp.db

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ghtsp_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ghtsp_db
PG_USER=postgres
PG_PASSWORD=your_pg_password_here

WINDOW_HOURS=24
SUBWINDOWS_M=12
KNN_K=3
NEWSWORTHINESS_THRESHOLD=4.0

